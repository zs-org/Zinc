pub const Vector2 = struct {
    x: f32,
    y: f32,
};

pub const Player = struct {
    pos: Vector2,
    id: i32,
};

fn test_structs() {
    const v1 = Vector2{ x = 1.0, y = 2.0 }
    const p1 = Player{
        pos = Vector2{ x = 3.0, y = 4.0 },
        id = 42,
    }

    local v2: Vector2 = Vector2{ x = 5.0, y = 6.0 }
}
